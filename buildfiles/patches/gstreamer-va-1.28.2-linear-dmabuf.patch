+static gboolean
+supports_linear_dma_format (GstVaDisplay * display, GstVideoFormat format,
+    guint32 fourcc, guint usage_hint, gint width, gint height)
+{
+  GstVideoInfoDmaDrm info;
+  GstAllocator *allocator;
+  gboolean supported;
+
+  gst_video_info_dma_drm_init (&info);
+  gst_video_info_set_format (&info.vinfo, format, width, height);
+  info.drm_fourcc = fourcc;
+  info.drm_modifier = DRM_FORMAT_MOD_LINEAR;
+  allocator = gst_va_dmabuf_allocator_new (display);
+  supported = gst_va_dmabuf_allocator_set_format (allocator, &info, usage_hint);
+  gst_object_unref (allocator);
+  return supported;
+}
