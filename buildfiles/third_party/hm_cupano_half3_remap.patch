 namespace pano {

+cv::Mat prepare_exposure_match_image(const cv::Mat& image) {
+  if (image.empty() || image.channels() < 3) {
+    return {};
+  }
+
+  std::vector<cv::Mat> channels;
+  cv::split(image, channels);
+  std::vector<cv::Mat> rgb_channels{
+      channels[0],
+      channels[1],
+      channels[2],
+  };
+  cv::Mat rgb;
+  cv::merge(rgb_channels, rgb);
+  cv::Mat prepared;
+  rgb.convertTo(prepared, CV_32F);
+  return prepared;
+}
+
