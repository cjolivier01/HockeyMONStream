@@ -2,6 +2,8 @@

 #include <cuda_runtime.h>

+#include "cupano/cuda/cudaTypes.h"
+
 template <typename T>
 void adjustImageCudaBatch(T* d_image, int batchSize, int width, int height, const float3& adjustment);

@@ -69,6 +71,18 @@
     return out;
   }
 };
+
+// Specialization for half3 (3-channel half-precision pixel)
+template <>
+struct PixelAdjuster<half3> {
+  __device__ static half3 adjust(const half3& pixel, const float3& adjustment) {
+    half3 out;
+    out.x = __float2half(__half2float(pixel.x) + adjustment.x);
+    out.y = __float2half(__half2float(pixel.y) + adjustment.y);
+    out.z = __float2half(__half2float(pixel.z) + adjustment.z);
+    return out;
+  }
+};

