# SimpleDBus
cc_library(
    name = "simpledbus",
    hdrs = glob([
        "simpledbus/include/**/*.h",
        "simpledbus/include/**/*.hpp",
        # External helper used by SimpleDBus (present in repo deps)
        "dependencies/external/kvn/kvn_safe_callback.hpp",
        "dependencies/external/kvn/logfwd.hpp",
    ]) + [
        # ":kvn_safe_callback_header",
        # ":kvn_logfwd_header",
    ],
    srcs = glob([
        "simpledbus/src/**/*.cpp",
    ]),
    includes = [
        # Allow includes like <simpledbus/...>
        "simpledbus/include",
        # External utilities (kvn_safe_callback.hpp)
        "dependencies/external",
        # Some upstream revisions reference headers under this path
        "simpleble/src/external",
        # External utilities (kvn_safe_callback.hpp)
        # "simpleble/src/external",
    ],
    copts = [
        "-std=c++17",
        # Add paths for kvn helpers referenced by Proxy.h
        "-Isimpledbus/include",
        "-Idependencies/external",
        "-Isimpleble/src/external",
        # "-Iexternal/simpleble",
        # "-Iexternal/simpleble/simpleble/src/external",
        # "-Iexternal/simpleble/dependencies/external",
        # "-Iexternal/simpleble/simpledbus/include",
        # "-Isimpledbus/include",
    ],
    defines = [
        "FMT_HEADER_ONLY=1",
    ],
    linkopts = [
        "-ldbus-1",
        "-lpthread",
        "-ldl",
    ],
    deps = [
        "@dbus//:dbus",
        "@com_github_fmtlib_fmt//:fmt",
    ],
    visibility = ["//visibility:public"],
)

# SimpleBluez (depends on SimpleDBus and BlueZ)
cc_library(
    name = "simplebluez",
    hdrs = glob([
        "simplebluez/include/**/*.h",
        "simplebluez/src/**/*.h",
        "simplebluez/src/**/*.hpp",
        "dependencies/external/**/*.h",
    ]) + [
        # ":kvn_safe_callback_header",
        # ":kvn_logfwd_header",
    ],
    srcs = glob([
        "simplebluez/src/**/*.cpp",
    ]),
    includes = [
        # Public headers
        "simplebluez/include",
        # Private headers reside in src tree and are included as "Header.h"
        "simplebluez/src",
        # External utilities (kvn_safe_callback.hpp)
        "simpleble/src/external",
        # External single-header deps used by Types.h
        "dependencies/external",
    ],
    copts = [
        "-std=c++17",
        # Provide a version string expected by Utils.cpp
        "-DSIMPLEBLE_VERSION=\"bazel\"",
        # Search package root for generated kvn headers with <kvn/...> includes
        "-Iexternal/simpleble",
    ],
    defines = [
        # Select Linux backend
        'SIMPLEBLE_BACKEND_LINUX=1',
        'SIMPLEBLE_BACKEND_WINDOWS=0',
        'SIMPLEBLE_BACKEND_ANDROID=0',
        'SIMPLEBLE_BACKEND_MACOS=0',
        'SIMPLEBLE_BACKEND_IOS=0',
        'SIMPLEBLE_BACKEND_PLAIN=0',
    ],
    linkopts = [
        "-lbluetooth",
    ],
    deps = [
        ":simpledbus",
        "@bluez//:bluez",
    ],
    visibility = ["//visibility:public"],
)

