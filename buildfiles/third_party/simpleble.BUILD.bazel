# SimpleBLE (Linux backend uses SimpleBluez)
cc_library(
    name = "simpleble",
    hdrs = glob([
        "simpleble/include/**/*.h",
        "simpleble/src/**/*.h",
        "simpleble/src/**/*.hpp",
        "dependencies/external/**/*.h",
    ]) + [
        # ":simpleble_export_header",
        # ":kvn_safe_callback_header",
        # ":kvn_logfwd_header",
    ],
    srcs = glob([
        # All common sources
        "simpleble/src/**/*.cpp",
    ], exclude = [
        # Exclude non-Linux backends
        "simpleble/src/backends/darwin/**",
        "simpleble/src/backends/macos/**",
        "simpleble/src/backends/corebluetooth/**",
        "simpleble/src/backends/windows/**",
        "simpleble/src/backends/winrt/**",
        "simpleble/src/backends/android/**",
        "simpleble/src/backends/plain/**",
        # Exclude C API and Utils that require version macro
        "simpleble/src_c/**",
        "simpleble/src/Utils.cpp",
    ]),
    includes = [
        ".",
        # Allow includes like <simpleble/...>
        "simpleble/include",
        # Private headers reside in src tree and are included as "Header.h"
        "simpleble/src",
        # Some headers are under a dedicated external dir (e.g., kvn_safe_callback.hpp)
        "simpleble/src/external",
        # Builder utilities referenced as local includes
        "simpleble/src/builders",
        # External single-header deps used by Types.h
        "dependencies/external",
        # Common backend private headers
        "simpleble/src/backends/common",
        # Linux legacy backend exposes headers under this prefix
        "simpleble/src/backends/linux_legacy/include",
    ],
    copts = [
        "-std=c++17",
        # Search package root for generated kvn headers with <kvn/...> includes
        "-Iexternal/simpleble",
    ],
    defines = [
        "FMT_HEADER_ONLY=1",
        # Select Linux backend explicitly to avoid accidental cross-backend includes
        'SIMPLEBLE_BACKEND_LINUX=1',
        'SIMPLEBLE_BACKEND_WINDOWS=0',
        'SIMPLEBLE_BACKEND_ANDROID=0',
        'SIMPLEBLE_BACKEND_MACOS=0',
        'SIMPLEBLE_BACKEND_IOS=0',
        'SIMPLEBLE_BACKEND_PLAIN=0',
    ],
    linkopts = [
        # Transitively pull in common system libs
        "-lpthread",
        "-ldl",
    ],
    deps = [
        ":simpledbus",
        ":simplebluez",
        "@//buildfiles/third_party/simpleble:export_header",
    ],
    visibility = ["//visibility:public"],
)
