+def _contiguous_frame_runs(frames: list[int]) -> list[list[int]]:
+    """Split sorted frame IDs wherever numeric timeline adjacency is lost."""
+    runs: list[list[int]] = []
+    for frame in frames:
+        if not runs or frame != runs[-1][-1] + 1:
+            runs.append([frame])
+        else:
+            runs[-1].append(frame)
+    return runs
+
