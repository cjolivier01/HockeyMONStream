#!/bin/bash
set -e
SCRIPT_DIR=$(dirname $(realpath $0))

#CPU="$(uname -p)"
#if [ "$CPU" == "x86_64" ]; then
#  CPU="k8"
#fi

if [ ! -e "$(which bazelisk)" ]; then
  echo "Need to install bazelisk."
  ./scripts/install_bazelisk.sh
fi

BAZEL_FLAGS="--config=debug"
HOST_ARCH="$(uname -m)"
IS_JETSON=0
if [ -e /etc/nv_tegra_release ]; then
  IS_JETSON=1
elif [ -r /proc/device-tree/compatible ] && tr '\0' '\n' < /proc/device-tree/compatible | grep -qi tegra; then
  IS_JETSON=1
fi
if [ "${HOST_ARCH}" = "aarch64" ] && [ "${IS_JETSON}" = "0" ]; then
  BAZEL_FLAGS="${BAZEL_FLAGS} --config=arm64"
fi
if [ -x "${SCRIPT_DIR}/scripts/bazel_cuda_host_config.sh" ]; then
  HOST_CUDA_FLAGS="$("${SCRIPT_DIR}/scripts/bazel_cuda_host_config.sh")"
  if [ -n "${HOST_CUDA_FLAGS}" ]; then
    BAZEL_FLAGS="${BAZEL_FLAGS} ${HOST_CUDA_FLAGS}"
  fi
fi

TARGET="$@"
if [ -z "${TARGET}" ]; then
  TARGET="//..."
fi

bazelisk build ${BAZEL_FLAGS} ${TARGET}
