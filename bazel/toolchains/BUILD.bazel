load("//bazel/toolchains:aarch64_cc_toolchain_config.bzl", "aarch64_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# Minimal aarch64 (Jetson) cross toolchain pointing to the system cross-binutils
# installed via gcc-aarch64-linux-gnu inside the cross container.
aarch64_cc_toolchain_config(
    name = "aarch64_toolchain_config",
)

filegroup(
    name = "empty",
    srcs = [],
)

cc_toolchain(
    name = "aarch64_toolchain",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
    toolchain_config = ":aarch64_toolchain_config",
    toolchain_identifier = "aarch64-linux-gnu-gcc",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

cc_toolchain_suite(
    name = "aarch64_suite",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    toolchains = {
        "aarch64": ":aarch64_toolchain",
        "aarch64|gcc": ":aarch64_toolchain",
    },
)

toolchain(
    name = "aarch64_gcc_toolchain",
    toolchain = ":aarch64_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)
