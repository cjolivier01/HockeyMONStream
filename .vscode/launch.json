        "LD_LIBRARY_PATH": "/usr/local/lib/x86_64-linux-gnu/:/usr/local/lib:/opt/nvidia/deepstream/deepstream/lib",
        "GST_PLUGIN_PATH": "/home/colivier/src/hmstream/lib/gst-plugins:/home/colivier/src/hmdeepstream/deepstream/lib/gst-plugins:/opt/nvidia/deepstream/deepstream/lib/gst-plugins",
        "GST_DEBUG": "5",
      },
      // "preLaunchTask": "Meson: Build all targets",
