load("@gst_plugin_dev//buildfiles:gst_plugin.bzl", "gst_cc_plugin")

INCLUDE_PREFIX = "hstream/src/gst-plugins/gst-playtracker"

gst_cc_plugin(
    name = "gstplaytracker",
    srcs = [
        "gstplaytracker.cpp",
        "gstplaytracker.h",
    ],
    copts = [
        # "-Wno-error=unused-function",
        # "-Wno-error=unused-variable",
    ],
    linkopts = [
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":playtracker_context",
    ],
)

cc_library(
  name = "playtracker_context",
  srcs = [
        "PlayTrackerCtx.cpp",
  ],
  hdrs = [
        "PlayTrackerCtx.h",
  ],
  include_prefix =   INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  deps = [
        "//src/libs/common:utils",
        "@hm//hockeymom/csrc/play_tracker:play_tracker",
  ],
)
