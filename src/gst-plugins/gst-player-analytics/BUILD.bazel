load("@gst_plugin_dev//buildfiles:gst_plugin.bzl", "gst_cc_plugin")

INCLUDE_PREFIX = "hstream/src/gst-plugins/gst-player-analytics"

cc_library(
    name = "processor",
    srcs = ["BorrowedImage.cpp", "PlayerAnalyticsProcessor.cpp"],
    hdrs = ["BorrowedImage.h", "PlayerAnalyticsProcessor.h"],
    include_prefix = INCLUDE_PREFIX,
    linkopts = ["-lcuda"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/player_analytics:config",
        "//src/libs/player_analytics:frame_meta",
        "//src/libs/player_analytics:temporal_state",
        "//src/libs/player_analytics/runtime:native_engine",
        "//src/libs/player_analytics/runtime:pose_gpu",
        "//src/libs/player_analytics/runtime:pose_affine",
        "//src/libs/stitching:stitched_output_generation_meta",
        "@deepstream//:deepstream_lib",
        "@local_cuda//:cuda",
        "//toolchains/jetson:cuda_runtime",
    ],
)

gst_cc_plugin(
    name = "gsthmplayeranalytics",
    srcs = ["GstPlayerAnalytics.cpp"],
    visibility = ["//visibility:public"],
    deps = [":processor"],
)

# Append a real compatible pose bundle to exercise inference and error fencing.
cc_binary(
    name = "player_analytics_plugin_test",
    srcs = ["PlayerAnalyticsPluginTest.cpp"],
    data = [":libgsthmplayeranalytics.so"],
    linkopts = ["-ldl", "-lgstcheck-1.0", "-Wl,--export-dynamic"],
    deps = [":processor", "@gstreamer"],
)

# Real odd-width EGL allocation/import regression; executes on native Jetson.
cc_binary(
    name = "borrowed_image_test",
    srcs = ["BorrowedImageTest.cpp"],
    deps = [":processor"],
)
