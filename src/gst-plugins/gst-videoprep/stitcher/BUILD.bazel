load("//bazel:cuda_dependencies.bzl", "cuda_dependencies")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

INCLUDE_PREFIX = "hstream/src/gst-plugins/gst-videoprep/stitcher"

cuda_library(
    name = "high_bit_stitch_cuda",
    srcs = ["cudaHighBitStitch.cu"],
    copts = [
        "-Xcompiler=-fPIC",
        "-Wno-deprecated-gpu-targets",
    ],
    visibility = ["//visibility:private"],
    deps = cuda_dependencies("high_bit_stitch_cuda", [
        ":high_bit_stitch_cuda_h",
        "//src/gst-plugins/gst-videoprep/playcropper:shadow_tone_curve",
        "//toolchains/jetson:cuda_runtime",
        "@deepstream//:deepstream_lib",
        "@hm-cupano//src/pano:cuda_pano",
    ]),
)

cc_library(
    name = "high_bit_stitch_cuda_h",
    hdrs = ["cudaHighBitStitch.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = cuda_dependencies("high_bit_stitch_cuda_h", [
        "//toolchains/jetson:cuda_runtime",
