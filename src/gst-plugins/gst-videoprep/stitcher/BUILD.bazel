cc_test(
    name = "one_pass_stitcher_test",
    # Lazy kernel loading can synchronize before the fault fixture's gated stream reaches its allocation.
    env = {"CUDA_MODULE_LOADING": "EAGER"},
    srcs = [
        "OnePassStitcherTest.cpp",
    ],
    deps = cuda_dependencies("one_pass_stitcher_test", [
        ":stitcher",
        "//src/gst-plugins/gst-videoprep/algorithm-base",
        "//src/libs/common:utils",
        "//src/libs/stitching",
        "//src/libs/stitching:player_frame_input_store",
        "//src/libs/stitching:calibration_matches",
        "@deepstream//:deepstream_lib",
        "@hm-cupano//src/cuda:cuda_blend_cuda_lib",
        "@hm-cupano//src/pano:cuda_pano",
        "//toolchains/jetson:cuda_runtime",
        "@local_cuda//:nppc",
        "@local_cuda//:nppig",
        "@gstreamer",
        "@opencv_linux//:opencv",
    ], testonly = True),
    copts = [
        "-x",
        "c++",
        "-std=c++17",
    ],
    linkopts = [
        "-ldl",
        "-lm",
