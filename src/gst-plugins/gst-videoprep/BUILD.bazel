load("@gst_plugin_dev//buildfiles:gst_plugin.bzl", "gst_cc_plugin")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

config_setting(
    name = "x86_64-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "aarch64-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64"],
)

gst_cc_plugin(
    name = "nvdsgst_videoprep",
    srcs = glob([
        "gstvideoprep.cpp",
        "videoprep_plugins.cpp",
    ]),
    hdrs = glob([
        "gstvideoprep.h",
        "videoprep_plugins.h",
        "videoprep_property_parser.h"
    ]),
    copts = [
        "-Iincludes",
        "-Wno-error=unused-function",
        "-Wno-error=unused-variable",
        "-Wno-error=write-strings",
        "-DIN_GSTVIDEOPREP_PLUGIN=1",
    ],
    linkopts = select({
        ":aarch64-linux-gnu": ["-L/usr/local/cuda/targets/aarch64-linux/lib"],
        ":x86_64-linux-gnu": ["-L/usr/local/cuda/targets/x86_64-linux/lib"],
        "//conditions:default": [],
    }) + [
        "-l:libnppig.so",
        "-lnppc_static",
        "-lnppif_static",
        "-lnvdsgst_customhelper",
        "-lnvdsgst_helper",
        "-lnvdsgst_meta",
        "-lnvds_meta",
        "-lnvdsbufferpool",
        "-lnvbufsurface",
        "-lnvbufsurftransform",
        "-lnvds_csvparser",
        "-lnvds_dewarper",
        "-lnvds_nvtxhelper",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":playcropper_lib",
        ":stitcher_lib",
        "//src/libs/common:utils",
        "@com_google_absl//absl/strings",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display:display",
    ],
)

cc_library(
    name = "playcropper_lib",
    srcs = [
      "playcropper.cpp",
    ],
    hdrs = [
      "playcropper.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":play_cropper_cuda_lib",
        "//src/gst-plugins/gst-videoprep/algorithm-base",
    ],
)

cc_library(
    name = "stitcher_lib",
    srcs = [
      "stitcher.cpp",
    ],
    hdrs = [
      "stitcher.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//src/gst-plugins/gst-videoprep/algorithm-base",
        "//src/libs/stitching",
        "@hm-cupano//src/cuda:cuda_blend_cuda_lib",
        "@hm-cupano//src/pano:cuda_pano",
    ],
)

