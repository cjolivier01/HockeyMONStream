load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@gst_plugin_dev//buildfiles:gst_plugin.bzl", "gst_cc_plugin")

config_setting(
    name = "x86_64-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "aarch64-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64"],
)

gst_cc_plugin(
    name = "nvdsgst_videoprep",
    srcs = glob([
        "*.cpp",
        "customlib_impl/*.cpp",
    ]),
    hdrs = glob([
        "*.h",
        "includes/*.hpp",
    ]),
    copts = [
        "-Iincludes",
        "-Wno-error=unused-function",
        "-Wno-error=unused-variable",
        "-Wno-error=write-strings",
    ],
    includes = [
        "includes",
    ],
    linkopts = select({
        ":aarch64-linux-gnu": ["-L/usr/local/cuda/targets/aarch64-linux/lib"],
        ":x86_64-linux-gnu": ["-L/usr/local/cuda/targets/x86_64-linux/lib"],
        "//conditions:default": [],
    }) + [
        "-l:libnppig.so",
        "-lnppc_static",
        "-lnppif_static",
        "-lnvdsgst_helper",
        "-lnvdsgst_meta",
        "-lnvds_meta",
        "-lnvdsbufferpool",
        "-lnvbufsurface",
        "-lnvbufsurftransform",
        "-lnvds_csvparser",
        "-lnvds_dewarper",
        "-lnvds_nvtxhelper",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":play_cropper_cuda_lib",
        "//src/libs/common:utils",
        "@com_google_absl//absl/strings",
        "@hm-cupano//src/pano:cuda_pano",
        "@hm-cupano//src/cuda:cuda_blend_cuda_lib",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display:display",
    ],
)

cuda_library(
    name = "play_cropper_cuda_lib",
    srcs = [
        "cudaPlayCropper.cu",
    ],
    hdrs = [
    ],
    copts = [
        "-std=c++17",
        "-Xcompiler=-fPIC",
        # "-Xcompiler=-rdynamic",
        #"-Xcompiler=-O0",
        #"-Xcompiler=-g",
        "-Wno-deprecated-gpu-targets",
        #"-G",
        #"-g",
        "-keep",
        #"-O0",
    ],
    # includes = ["."],
    visibility = ["//visibility:private"],
    deps = [
        # "@opencv_linux//:opencv",
        "//src/libs/common:utils",
        "@deepstream//:deepstream_lib",
        "@local_cuda//:cuda_runtime",
    ],
)
