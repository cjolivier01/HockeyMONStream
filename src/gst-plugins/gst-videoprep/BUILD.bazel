load("@gst_plugin_dev//buildfiles:gst_plugin.bzl", "gst_cc_plugin")

config_setting(
    name = "x86_64-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "jetson",
    values = {"define": "target_platform=jetson"},
)

config_setting(
    name = "arm64-sbsa",
    values = {"define": "target_platform=arm64"},
)

gst_cc_plugin(
    name = "nvdsgst_videoprep",
    srcs = glob([
        "gstvideoprep.cpp",
        "videoprep_plugins.cpp",
    ]),
    hdrs = glob([
        "gstvideoprep.h",
        "videoprep_plugins.h",
        "videoprep_property_parser.h",
    ]),
    copts = [
        "-Iincludes",
        "-Wno-error=unused-function",
        "-Wno-error=unused-variable",
        "-Wno-error=write-strings",
        "-DIN_GSTVIDEOPREP_PLUGIN=1",
    ],
    linkopts = select({
        ":jetson": ["-L/opt/jetson-sysroot/usr/local/cuda/targets/aarch64-linux/lib"],
        ":arm64-sbsa": [
            "-L/usr/local/cuda/targets/sbsa-linux/lib",
            "-L/usr/local/cuda/targets/aarch64-linux/lib",
            "-L/usr/local/cuda/lib64",
        ],
        "//conditions:default": ["-L/usr/local/cuda/targets/x86_64-linux/lib"],
    }) + [
        "-l:libnppig.so",
        "-lnppc_static",
        "-lnppif_static",
        "-lnvdsgst_customhelper",
        "-lnvdsgst_helper",
        "-lnvdsgst_meta",
        "-lnvds_meta",
        "-lnvdsbufferpool",
        "-lnvbufsurface",
        "-lnvbufsurftransform",
        "-lnvds_csvparser",
        "-lnvds_dewarper",
        "-lnvds_nvtxhelper",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/gst-plugins/gst-videoprep/playcropper",
        "//src/gst-plugins/gst-videoprep/playtracker",
        "//src/gst-plugins/gst-videoprep/stitcher",
        "//src/libs/common:utils",
        "//src/libs/stitching:live_output_epoch",
        "@com_google_absl//absl/strings",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display:display",
    ],
)

cc_test(
    name = "videoprep_plugin_test",
    srcs = [
        "GstVideoPrepPluginTest.cpp",
    ],
    copts = [
        "-x",
        "c++",
        "-std=c++17",
    ],
    data = [
        ":libnvdsgst_videoprep.so",
    ],
    deps = [
        "//src/gst-plugins/testutils:gst_plugin_test_harness",
        "@gstreamer",
    ],
)
