    include_prefix = "hstream/src/libs/media",
    deps = ["@gstreamer"],
)

cc_test(
    name = "camera_display_caps_test",
    srcs = ["CameraDisplayCapsTest.cpp"],
    deps = [":camera_display_caps"],
)

