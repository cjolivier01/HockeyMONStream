load("//bazel:cuda_dependencies.bzl", "cuda_dependencies")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

INCLUDE_PREFIX = "hstream/src/libs/scoreboard"

cc_library(
    name = "scoreboard",
    srcs = ["Scoreboard.cpp"],
    hdrs = ["Scoreboard.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = cuda_dependencies("scoreboard", [
        ":scoreboard_cuda",
        ":placement",
        ":rectangle",
        "//src/libs/common:utils",
        "@com_google_absl//absl/synchronization",
        "@hm-cupano//src/pano:cuda_matrix",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display",
        "@opencv_linux//:opencv",
    ]),
)

cuda_library(
    name = "scoreboard_cuda",
    srcs = ["ScoreboardCuda.cu"],
    hdrs = ["ScoreboardCuda.h"],
    copts = ["-Xcompiler=-fPIC"],
    deps = cuda_dependencies("scoreboard_cuda", ["//toolchains/jetson:cuda_runtime"]),
)

cc_binary(
    name = "scoreboard_test",
    srcs = ["ScoreboardTest.cpp"],
    deps = [
        ":scoreboard",
    ],
)

cc_test(
    name = "scoreboard_interpolation_test",
    srcs = ["ScoreboardInterpolationTest.cpp"],
    deps = [
        ":scoreboard",
        "@opencv_linux//:opencv",
    ],
)

cc_test(
    name = "scoreboard_cuda_alpha_test",
    srcs = ["ScoreboardCudaAlphaTest.cpp"],
    tags = ["manual", "requires-deepstream-hw"],
    deps = [
        ":scoreboard_cuda",
        "@jetson-utils//cuda:cuda_lib",
        "//toolchains/jetson:cuda_runtime",
    ],
)

cc_library(
    name = "placement",
    hdrs = ["ScoreboardPlacement.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "rectangle",
    hdrs = ["ScoreboardRectangle.h"],
    include_prefix = INCLUDE_PREFIX,
    deps = [":placement", "@opencv_linux//:opencv"],
)

cc_library(
    name = "plan",
    srcs = ["ScoreboardPlan.cpp"],
    hdrs = ["ScoreboardPlan.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [":placement", ":rectangle", "@opencv_linux//:opencv", "@com_google_absl//absl/status:statusor"],
)

cc_test(
    name = "scoreboard_warp_cuda_test",
    srcs = ["ScoreboardWarpCudaTest.cpp"],
    tags = ["manual", "requires-deepstream-hw"],
    deps = [":scoreboard", "@opencv_linux//:opencv"],
)

cc_library(
    name = "camera_region",
    srcs = ["CameraRegion.cpp"],
    hdrs = ["CameraRegion.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/gpu:image",
        "@com_google_absl//absl/status:statusor",
        "@opencv_linux//:opencv",
    ],
)

cc_test(
    name = "camera_region_test",
    srcs = ["CameraRegionTest.cpp"],
    deps = [
        ":camera_region",
        ":plan",
    ],
)

cc_library(
    name = "camera_frames",
    srcs = ["CameraFrames.cpp"],
    hdrs = ["CameraFrames.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "camera_decoder",
    srcs = ["CameraDecoder.cpp"],
    hdrs = ["CameraDecoder.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":camera_region",
        "//src/libs/gpu/vaapi:va_element",
        "//src/libs/media:mp4_video_track",
        "@com_google_absl//absl/status:statusor",
        "@gstreamer",
    ],
)

cc_test(
    name = "camera_decoder_test",
    srcs = ["CameraDecoderTest.cpp"],
    tags = [
        "local",
        "manual",
        "requires-gpu",
    ],
    deps = [
        ":camera_decoder",
        ":camera_images",
        ":camera_session",
        "//src/libs/media:mp4_video_track",
        "//src/libs/media:test_mp4",
    ],
)

cc_test(
    name = "camera_frames_test",
    srcs = ["CameraFramesTest.cpp"],
    deps = [":camera_frames"],
)

cc_library(
    name = "camera_images",
    srcs = ["CameraImages.cpp"],
    hdrs = ["CameraImages.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":camera_decoder",
        "//src/libs/gpu:convert_image",
    ] + select({
        "//:use_hip": ["//src/libs/detection:va_detector_image"],
        "//conditions:default": ["//src/libs/common:surface"],
    }),
)

cc_library(
    name = "camera_session",
    srcs = ["CameraSession.cpp"],
    hdrs = ["CameraSession.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":camera_frames",
        ":camera_images",
    ],
)

cc_library(
    name = "camera_config",
    srcs = ["CameraConfig.cpp"],
    hdrs = ["CameraConfig.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":camera_session",
        "//src/libs/media:mp4_video_track",
        "@yaml-cpp",
    ],
)

cc_test(
    name = "camera_config_test",
    srcs = ["CameraConfigTest.cpp"],
    args = ["$(location //configs:baseline.yaml)"],
    data = ["//configs:baseline.yaml"],
    deps = [
        ":camera_config",
        "//src/libs/media:test_mp4",
    ],
)
