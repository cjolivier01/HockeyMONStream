load("@rules_cc//cc:defs.bzl", "cc_library")

INCLUDE_PREFIX = "hstream/src/libs/scoreboard"

config_setting(
    name = "aarch64-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64"],
)

cc_library(
    name = "scoreboard",
    srcs = ["Scoreboard.cpp"],
    hdrs = ["Scoreboard.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    linkopts = select({
        ":aarch64-linux-gnu": [
            "-L/opt/jetson-sysroot/usr/lib/aarch64-linux-gnu",
            "-l:libopencv_cudawarping.so",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//src/libs/common:utils",
        "@com_google_absl//absl/synchronization",
        "@hm-cupano//src/pano:cuda_matrix",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display",
        "@opencv_linux//:opencv",
    ],
)

cc_binary(
    name = "scoreboard_test",
    srcs = ["ScoreboardTest.cpp"],
    deps = [
        ":scoreboard",
    ],
)
