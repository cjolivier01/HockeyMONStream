load("@rules_cc//cc:defs.bzl", "cc_library")

INCLUDE_PREFIX = "hstream/src/libs/scoreboard"

cc_library(
    name = "scoreboard",
    srcs = ["Scoreboard.cpp"],
    hdrs = ["Scoreboard.h"],
    include_prefix = INCLUDE_PREFIX,
    # Ubuntu's system OpenCV packages often omit the CUDA modules/headers (e.g. `opencv2/cudawarping.hpp`).
    # Use our CUDA warp implementation from jetson-utils by default so `//...` builds out of the box.
    defines = ["USE_PRIVATE_WARP"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/common:utils",
        "@com_google_absl//absl/synchronization",
        "@hm-cupano//src/pano:cuda_matrix",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display",
        "@opencv_linux//:opencv",
    ],
)

cc_binary(
    name = "scoreboard_test",
    srcs = ["ScoreboardTest.cpp"],
    deps = [
        ":scoreboard",
    ],
)
