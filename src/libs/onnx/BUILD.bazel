INCLUDE_PREFIX = "hstream/src/libs/onnx"

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

cc_library(
    name = "onnxruntime",
    visibility = ["//visibility:private"],
    deps = select({
        ":linux_aarch64": ["@onnxruntime_linux_aarch64//:onnxruntime"],
        ":linux_x86_64": ["@onnxruntime_linux_x86_64//:onnxruntime"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_library(
    name = "session",
    srcs = ["OnnxSession.cpp"],
    hdrs = ["OnnxSession.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":onnxruntime",
        "@com_google_absl//absl/status:status",
        "@com_google_absl//absl/status:statusor",
    ],
)

cc_test(
    name = "session_test",
    srcs = ["OnnxSessionTest.cpp"],
    deps = [":session"],
)

filegroup(
    name = "runtime_files",
    srcs = select({
        ":linux_aarch64": ["@onnxruntime_linux_aarch64//:runtime_files"],
        ":linux_x86_64": ["@onnxruntime_linux_x86_64//:runtime_files"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)
