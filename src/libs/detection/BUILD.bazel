load("//bazel:gpu_library.bzl", "gpu_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "gpu_headers",
    hdrs = ["DetectorGpu.h"],
    include_prefix = "hstream/src/libs/detection",
    deps = [":types", "//src/libs/gpu:runtime"],
)

gpu_library(
    name = "gpu",
    srcs = ["DetectorGpu.cu"],
    deps = [":gpu_headers"],
)

cc_library(
    name = "types",
    hdrs = ["DetectionTypes.h"],
    include_prefix = "hstream/src/libs/detection",
)

cc_library(
    name = "postprocess",
    srcs = ["DetectionPostprocess.cpp"],
    hdrs = ["DetectionPostprocess.h"],
    include_prefix = "hstream/src/libs/detection",
    deps = [":types", "@com_google_absl//absl/status:statusor"],
)

cc_library(
    name = "hip_detector",
    srcs = ["HipDetector.cpp"],
    hdrs = ["HipDetector.h"],
    include_prefix = "hstream/src/libs/detection",
    target_compatible_with = select({
        "//:use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":gpu", ":postprocess", "//src/libs/gpu/migraphx:session"],
)

cc_test(
    name = "gpu_test",
    srcs = ["DetectorGpuTest.cpp"],
    tags = ["manual", "requires-gpu"],
    deps = [":gpu", ":postprocess", "@opencv_linux//:opencv"],
)

cc_binary(
    name = "hip_detector_fixture",
    srcs = ["HipDetectorFixture.cpp"],
    target_compatible_with = select({
        "//:use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":hip_detector", "@opencv_linux//:opencv", "@yaml-cpp"],
)

cc_test(
    name = "postprocess_test",
    srcs = ["DetectionPostprocessTest.cpp"],
    deps = [":postprocess"],
)

cc_library(
    name = "va_detector_image",
    srcs = ["VaDetectorImage.cpp"],
    hdrs = ["VaDetectorImage.h"],
    include_prefix = "hstream/src/libs/detection",
    target_compatible_with = select({
        "//:use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":gpu_headers", "//src/libs/gpu/vaapi:va_hip_frame"],
)

cc_test(
    name = "hip_detector_failure_test",
    linkstatic = True,
    srcs = ["HipDetectorFailureTest.cpp"],
    tags = ["manual", "gpu", "local"],
    linkopts = ["-Wl,--wrap=migraphx_program_run_async"],
    target_compatible_with = select({
        "//:use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":hip_detector", "@hstream_rocm//:migraphx"],
)

cc_library(
    name = "rink_detection_mask",
    srcs = ["RinkDetectionMask.cpp"],
    hdrs = ["RinkDetectionMask.h"],
    include_prefix = "hstream/src/libs/detection",
    deps = ["@opencv_linux//:opencv"],
)

cc_test(
    name = "rink_detection_mask_test",
    srcs = ["RinkDetectionMaskTest.cpp"],
    deps = [":rink_detection_mask"],
)

cc_test(
    name = "va_detector_image_test",
    srcs = ["VaDetectorImageTest.cpp"],
    tags = ["manual", "gpu", "local"],
    timeout = "moderate",
    target_compatible_with = select({
        "//:use_hip": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":va_detector_image"],
)
