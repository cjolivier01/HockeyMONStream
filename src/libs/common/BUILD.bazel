INCLUDE_PREFIX = "hstream/src/libs/common/"

cc_library(
    name = "utils",
    srcs = glob([
        "*.cpp",
    ], exclude = ["ModPipeline.cpp", "Surface.cpp"]),
    hdrs = glob([
        "*.h",
    ], exclude = ["ModPipeline.h", "Surface.h"]),
    copts = [
        "-fPIC",
        "-std=c++20",
    ],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        ":surface",
        "@deepstream//:deepstream_lib",
        "@gstreamer",
        "@hm//hockeymom/csrc/play_tracker",
        "@hm-cupano//src/cuda:cuda_blend_cuda_lib",
        "@com_google_absl//absl/strings:strings",
        "@com_google_absl//absl/status:statusor",
        "@jetson-utils//cuda:cuda_lib",
        "@jetson-utils//display",
        "@local_cuda//:cuda",
        "@local_cuda//:cuda_runtime",
        "@opencv_linux//:opencv",
        "@yaml-cpp",
    ],
)

cc_library(
  name = "surface",
  srcs = ["Surface.cpp"],
  hdrs = ["Surface.h"],
  include_prefix=INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  deps = [
    "@hm//hockeymom/csrc/play_tracker",
    "@deepstream//:deepstream_lib",
    "@jetson-utils//image:image_format",
    "@glib",
  ],
)

cc_library(
  name = "mod_pipeline",
  srcs = ["ModPipeline.cpp"],
  hdrs = ["ModPipeline.h"],
  include_prefix=INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  deps = [
    ":utils",
    "@gtk3",
    "@gstreamer",
  ],
)

cc_library(
  name = "perspective",
  srcs = ["Perspective.cpp"],
  hdrs = ["Perspective.h"],
  include_prefix=INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  deps = [
  ],
)
