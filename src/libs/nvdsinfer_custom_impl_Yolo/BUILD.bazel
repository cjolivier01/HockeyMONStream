load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

cc_binary(
    name = "nvdsinfer_custom_impl_Yolo",
    srcs = glob([
        "*.cpp",
        "layers/*.cpp",
    ], exclude = ["*Test.cpp"]),
    copts = [
        "-Wall",
        "-std=c++17",
        "-fPIC",
        "-Wno-error=deprecated-declarations",
        "-DWITH_CUDA",
        "-DOPENCV",
    ],
    linkopts = [
        "-shared",
        "-Wl,-z,defs",
        # TensorRT retains the REGISTER_TENSORRT_PLUGIN creator for the process.
        # DeepStream dlcloses custom libraries on graph teardown; unloading this
        # creator leaves a dangling registry entry that crashes the next load.
        "-Wl,-z,nodelete",
        "-Wno-error=deprecated-declarations",
        "-Wl,--start-group",
        "-lnvinfer_plugin",
        "-lnvinfer",
        "-lnvonnxparser",
        "-L/usr/local/cuda/lib64",
        "-lcudart",
        "-lcublas",
        "-lstdc++fs",
        "-Wl,--end-group",
    ],
    deps=[
        ":nvdsinfer_custom_impl_Yolo_cuda_lib",
        "@deepstream//:deepstream_includes",
        "@deepstream//:nvdsinfer",
        # "@NvDsBaseExt",
        # "@NvDsInterfaceExt",
        # "@StandardExtension",
        "@glib",
        "@gstreamer",
        "@opencv_linux//:opencv",
        "//toolchains/jetson:cuda_runtime",
    ],
    linkshared = True,
    visibility = ["//visibility:public"],
)

cc_test(
    name = "plugin_lifetime_test",
    srcs = ["PluginLifetimeTest.cpp"],
    args = ["$(location :nvdsinfer_custom_impl_Yolo)"],
    data = [":nvdsinfer_custom_impl_Yolo"],
    deps = ["@deepstream//:deepstream_includes", "@local_cuda//:cuda"],
    linkopts = ["-lnvinfer", "-ldl"],
)

cuda_library(
    name = "nvdsinfer_custom_impl_Yolo_cuda_lib",
    srcs=glob([
        "*.cu",
    ]),
    copts=[
        "-std=c++17",
        "-Xcompiler=-fPIC",
        "-Xcompiler=-g",
        "-DWITH_CUDA",
        "-g",
    ],
    deps = [
        "@deepstream//:deepstream_includes",
        ":nvdsinfer_custom_impl_Yolo_headers",
        "//toolchains/jetson:cuda_runtime",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvdsinfer_custom_impl_Yolo_headers",
    hdrs = glob([
        "*.h",
        "layers/*.h",
    ]),
    visibility = ["//visibility:public"],
)
