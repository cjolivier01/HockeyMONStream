INCLUDE_PREFIX = "hstream/src/libs/stitching"

filegroup(
  name = "runtime_sources",
  srcs = glob(
    ["*.cpp", "*.h"],
    exclude = ["*Test.cpp"],
  ),
  visibility = ["//visibility:public"],
)

cc_library(
  name = "game_config",
  srcs = ["GameConfig.cpp"],
  hdrs = ["GameConfig.h"],
  include_prefix = INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  deps = [
    "@yaml-cpp",
    "@com_google_absl//absl/status:status",
    "@com_google_absl//absl/status:statusor",
  ],
)

cc_library(
  name = "orientation_internal",
  hdrs = ["OrientationInternal.h"],
  include_prefix = INCLUDE_PREFIX,
  visibility = ["//visibility:private"],
  deps = ["@com_google_absl//absl/status:status"],
)

cc_library(
  name = "stitching",
  srcs = [
    "CalibrationModels.cpp",
    "ConfigureStitching.cpp",
    "Orientation.cpp",
    "ScoreboardSelector.cpp",
    "Synchronization.cpp",
  ],
  hdrs = [
    "CalibrationCompletion.h",
    "CalibrationModels.h",
    "ConfigureStitching.h",
    "FieldMaskArtifact.h",
    "Orientation.h",
    "ScoreboardSelector.h",
    "StitchedOutputGenerationPayload.h",
    "Synchronization.h",
  ],
  linkopts = [
    "-L/usr/local/lib",	  
    "-lavformat",
    "-lavcodec",
    "-lavutil",
    "-lswresample",  
  ],
  include_prefix = INCLUDE_PREFIX,
  visibility = ["//visibility:public"],
  implementation_deps = [":orientation_internal"],
  deps = [
    ":canvas_constraint_check",
    ":game_config",
    ":correlation",
    ":feature_matcher",
    ":hugin_project",
    ":rink_segmentation",
    "//src/libs/common:utils",
    "@hm-cupano//src/pano:cuda_matrix",
    "@yaml-cpp",
    "@com_google_absl//absl/status:status",
    "@com_google_absl//absl/status:statusor",
    "@opencv_linux//:opencv",
  ],
  data = [
    "@hm-cupano//scripts:all_scripts",
  ],
)

