load("@rules_cuda//cuda:defs.bzl", "cuda_library")

INCLUDE_PREFIX = "hstream/src/libs/player_analytics/runtime/"

cc_library(
    name = "native_engine",
    srcs = ["NativeEngine.cpp"],
    hdrs = ["NativeEngine.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/player_analytics:model_contract",
        "//src/libs/player_analytics:types",
        "@com_google_absl//absl/status:statusor",
        "@glib",
        "@local_cuda//:cuda",
        "@player_tensorrt//:runtime",
        "//toolchains/jetson:cuda_runtime",
    ],
)

cc_library(
    name = "pose_gpu_headers",
    hdrs = ["PoseGpu.h"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/player_analytics:types",
        "@com_google_absl//absl/status:statusor",
        "@local_cuda//:cuda",
        "//toolchains/jetson:cuda_runtime",
