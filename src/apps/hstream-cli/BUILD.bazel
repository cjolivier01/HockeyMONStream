exports_files([
  "PipelineApp.cpp",
  "configurator.cpp",
])

HSTREAM_CLI_SRCS = glob(
    [
        "*.cpp",
        "*.h",
    ],
    exclude = ["*Test.cpp"],
)

HSTREAM_CLI_COPTS = [
    "-x",
    "c++",
    "-std=c++17",
]

HSTREAM_CLI_LINKOPTS = [
    "-lX11",
    "-ldl",
    "-lm",
]

HSTREAM_CLI_RUNTIME_DATA = [
    "//src/gst-plugins:hstream_runtime_plugins",
    "//src/libs/nvdsinfer_custom_impl_Yolo:nvdsinfer_custom_impl_Yolo",
]

HSTREAM_CLI_DEPS = [
    "//src/libs/assets:asset_manager",
    "//src/libs/common:tensorrt_gpu_identity",
    # "//src/libs/common:mod_pipeline",
    "//src/libs/common:utils",
    "//src/libs/common:fs",
    "//src/libs/common:baseline_config",
    "//src/libs/common:detection_snapshot_meta",
    "//src/libs/common:stitching_frame_pair_meta",
    "//src/libs/stitching:player_frame_selection",
    "//src/libs/stitching:player_frame_overlap",
    "//src/gst-plugins/gst-fieldmask:fieldmask_payload",
    "//src/libs/common:playtracker_config_roles",
    "//src/libs/common:preview_overlay_meta",
    "//src/libs/common:user_config",
    "//src/libs/pipeline_controller:gst_property_service",
    "//src/libs/stitching",
    "//src/libs/stitching:stitching_reframe",
    "//src/libs/wireless:stream_control",
    "//src/gst-plugins/gst-playtracker:playtracker_runtime_config",
    "//src/apps/apps-common:deepstream_apps_common",
    "@deepstream//:deepstream_lib",
    "@hm-cupano//src/pano:canvas",
    "@gstreamer",
    "@opencv_linux//:opencv",
    "@yaml-cpp",
    "@json_glib",
    "//toolchains/jetson:cuda_runtime",
    "@local_cuda//:cuda",
    "@com_google_absl//absl/strings",
    "@com_google_absl//absl/status:statusor",
    "@com_google_absl//absl/cleanup",
]

filegroup(
    name = "runtime_sources",
    srcs = HSTREAM_CLI_SRCS,
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "hstream-cli",
    srcs = HSTREAM_CLI_SRCS,
    copts = HSTREAM_CLI_COPTS,
    data = HSTREAM_CLI_RUNTIME_DATA,
    linkopts = HSTREAM_CLI_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = HSTREAM_CLI_DEPS,
)

