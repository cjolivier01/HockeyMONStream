    name = "hm_gpu_preview_player_overlay_test",
    srcs = ["HmGpuPreviewPlayerOverlayTest.cpp"],
    target_compatible_with = select({
        "@platforms//cpu:x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":hm_gpu_preview",
        "//src/libs/common:preview_overlay_meta",
        "//src/libs/player_analytics:frame_meta",
        "//src/libs/stitching:playback_rink_map",
        "//src/libs/stitching:stitching",
        "@deepstream//:deepstream_lib",
        "@gstreamer",
    ],
)

cc_library(
    name = "webrtc_endpoint",
    srcs = ["WebRtcEndpoint.cpp"],
    hdrs = ["WebRtcEndpoint.h"],
    copts = ["-DGST_USE_UNSTABLE_API"],
    include_prefix = INCLUDE_PREFIX,
    visibility = ["//visibility:public"],
    deps = ["@gstreamer"],
)

cc_test(
    name = "webrtc_endpoint_test",
    srcs = ["WebRtcEndpointTest.cpp"],
    copts = ["-DGST_USE_UNSTABLE_API"],
    deps = [":webrtc_endpoint"],
)

cc_binary(
    name = "webrtc_preview_test_server",
    testonly = True,
    srcs = ["WebRtcPreviewTestServer.cpp"],
    deps = [
        ":deepstream_apps_common",
        ":preview_rtp_gate",
        ":preview_transport_monitor",
        ":selected_preview_stream",
        ":web_preview_observer",
        ":webrtc_endpoint",
        "@gstreamer",
    ],
)

cc_test(
    name = "web_preview_signaling_test",
    srcs = ["WebPreviewSignalingTest.cpp"],
    tags = ["local"],
    deps = [":deepstream_apps_common", ":web_preview_observer", ":webrtc_endpoint", "@gstreamer", "@libsoup"],
)
