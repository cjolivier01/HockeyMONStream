     case GST_STATE_CHANGE_READY_TO_PAUSED:
+      // Initialize before upstream streaming threads can deliver CAPS/EOS.
+      // Configuring under GST_OBJECT_LOCK in a CAPS callback can deadlock
+      // against another input pushing a serialized event while holding the
+      // helper mutex, and late initialization discards early EOS accounting.
+      if (!mux->module_initialized)
+        configure_module(mux);
+      // A new playback starts with every requested source active. Waiting
+      // for each CAPS callback to clear old EOS lets the first source emit
+      // undersized batches while its peers are still starting.
+      for (GList *item = element->sinkpads; item; item = item->next) {
+        guint id = 0;
+        if (sscanf(GST_PAD_NAME(item->data), "sink_%u", &id) == 1) {
+          SinkPad *input = mux->helper->get_pad(id);
+          if (input)
+            mux->helper->reset_pad(input);
+        }
+      }
       mux->helper->handle_ready_pause();

