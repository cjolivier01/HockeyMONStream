exports_files(["HStreamWindow.cpp"])

COMMON_COPTS = [
    "-x",
    "c++",
    "-std=c++17",
    "-fPIC",
]

config_setting(
    name = "jetson_build",
    values = {"define": "target_platform=jetson"},
)

QT_UI_COMPATIBILITY = select({
    ":jetson_build": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

filegroup(
    name = "runtime_sources",
    srcs = [
        "HStreamWindow.cpp",
        "HStreamWindow.h",
        "main.cpp",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "hstream_window",
    srcs = ["HStreamWindow.cpp"],
    hdrs = ["HStreamWindow.h"],
    copts = COMMON_COPTS,
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        "//src/libs/stitching:game_config",
        "@qt//:qt_widgets",
        "@yaml-cpp",
    ],
)

cc_binary(
    name = "hstream-ui",
    srcs = ["main.cpp"],
    copts = COMMON_COPTS,
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":hstream_window",
        "@qt//:qt_widgets",
    ],
)

cc_binary(
    name = "hstream_ui_visual_verifier",
    testonly = True,
    srcs = ["HStreamUiVisualVerifier.cpp"],
    copts = COMMON_COPTS,
    linkopts = [
        "-lopencv_calib3d",
        "-lopencv_features2d",
    ],
    target_compatible_with = QT_UI_COMPATIBILITY,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@opencv_linux//:opencv"],
)

cc_test(
    name = "hstream_ui_test",
    srcs = ["HStreamWindowTest.cpp"],
    copts = COMMON_COPTS,
    env = {
        "QT_QPA_PLATFORM": "offscreen",
    },
    target_compatible_with = QT_UI_COMPATIBILITY,
    deps = [
        ":hstream_window",
        "@qt//:qt_test",
        "@qt//:qt_widgets",
        "@yaml-cpp",
    ],
)
