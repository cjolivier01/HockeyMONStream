exports_files(["HStreamWindow.cpp"])

COMMON_COPTS = [
    "-x",
    "c++",
    "-std=c++17",
    "-fPIC",
    # Qt's inline members are emitted as weak globals in every translation unit
    # that uses them, and from a .so they escape into the global symbol table --
    # ~1200 of them per library here. Any other Qt in the process then risks
    # binding to ours instead of its own. Qt's own build uses this flag for the
    # same reason; it leaves vtables and typeinfo alone, so moc and dynamic_cast
    # are unaffected.
    "-fvisibility-inlines-hidden",
]

config_setting(
    name = "jetson_build",
    values = {"define": "target_platform=jetson"},
)

