exports_files(["HStreamWindow.cpp"])

COMMON_COPTS = [
    "-x",
    "c++",
    "-std=c++17",
    "-fPIC",
]

config_setting(
    name = "jetson_build",
    values = {"define": "target_platform=jetson"},
)

QT_UI_COMPATIBILITY = select({
    ":jetson_build": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

filegroup(
    name = "runtime_sources",
    srcs = [
        "HStreamWindow.cpp",
        "HStreamWindow.h",
        "PipelineInspectorWidget.cpp",
        "PipelineInspectorWidget.h",
        "ScoreboardSelectionDialog.cpp",
        "ScoreboardSelectionDialog.h",
        "hstream-ui.desktop",
        "hstream-ui.svg",
        "main.cpp",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "scoreboard_selection_dialog",
    srcs = ["ScoreboardSelectionDialog.cpp"],
    hdrs = ["ScoreboardSelectionDialog.h"],
    copts = COMMON_COPTS,
    linkopts = ["-lpng"],
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        "@qt//:qt_network",
        "@qt//:qt_widgets",
    ],
)

cc_library(
    name = "pipeline_inspector_widget",
    srcs = ["PipelineInspectorWidget.cpp"],
    hdrs = ["PipelineInspectorWidget.h"],
    copts = COMMON_COPTS,
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = ["@qt//:qt_widgets"],
)

cc_library(
    name = "hstream_window",
    srcs = ["HStreamWindow.cpp"],
    hdrs = ["HStreamWindow.h"],
    copts = COMMON_COPTS,
    linkopts = ["-lxcb"],
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":pipeline_inspector_widget",
        ":scoreboard_selection_dialog",
        "//src/libs/common:baseline_config",
        "//src/libs/common:playtracker_config_roles",
        "//src/libs/common:user_config",
        "//src/libs/stitching:canvas_constraint_check",
        "//src/libs/stitching:control_point_matcher",
        "//src/libs/stitching:game_config",
        "//src/libs/stitching:live_output_epoch",
        "//src/libs/stitching:live_stitching_generation",
        "//src/libs/stitching:stitching_algorithms",
        "@qt//:qt_widgets",
        "@yaml-cpp",
    ],
)

cc_test(
    name = "pipeline_inspector_widget_test",
    srcs = ["PipelineInspectorWidgetTest.cpp"],
    copts = COMMON_COPTS,
    env = {
        "QT_QPA_PLATFORM": "offscreen",
    },
    target_compatible_with = QT_UI_COMPATIBILITY,
    deps = [
        ":pipeline_inspector_widget",
        "@qt//:qt_widgets",
    ],
)

cc_binary(
    name = "hstream-ui",
    srcs = ["main.cpp"],
    copts = COMMON_COPTS,
    data = ["//src/apps/pipeline-app:hstream-cli"],
    target_compatible_with = QT_UI_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":hstream_window",
        # DeepStream's nvbufsurface libraries use the CUDA Driver API. Link
        # the toolkit stub so package builds do not require a host GPU driver.
        "@local_cuda//:cuda",
        "@qt//:qt_widgets",
    ],
)

cc_binary(
    name = "hstream_ui_visual_verifier",
    testonly = True,
    srcs = ["HStreamUiVisualVerifier.cpp"],
    copts = COMMON_COPTS,
    linkopts = [
        "-lopencv_calib3d",
        "-lopencv_features2d",
    ],
    target_compatible_with = QT_UI_COMPATIBILITY,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@opencv_linux//:opencv"],
)

cc_test(
    name = "hstream_ui_test",
    srcs = ["HStreamWindowTest.cpp"],
    copts = COMMON_COPTS,
    linkopts = ["-lX11"],
    env = {
        "QT_QPA_PLATFORM": "offscreen",
    },
    target_compatible_with = QT_UI_COMPATIBILITY,
    deps = [
        ":hstream_window",
        ":scoreboard_selection_dialog",
        "//src/gst-plugins/gst-playtracker:playtracker_runtime_config",
        "//src/libs/stitching:canvas_constraint_check",
        "@qt//:qt_test",
        "@qt//:qt_widgets",
        "@yaml-cpp",
    ],
)

cc_test(
    name = "scoreboard_selection_dialog_test",
    srcs = ["ScoreboardSelectionDialogTest.cpp"],
    copts = COMMON_COPTS,
    env = {
        "QT_QPA_PLATFORM": "offscreen",
    },
    target_compatible_with = QT_UI_COMPATIBILITY,
    deps = [
        ":scoreboard_selection_dialog",
        "@qt//:qt_network",
        "@qt//:qt_test",
        "@qt//:qt_widgets",
    ],
)
