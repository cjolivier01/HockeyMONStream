load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# Common C++ options
COMMON_COPTS = [
    "-std=c++17",  # Use C++17 instead of C++11
    "-I$(GENDIR)",
    "-fPIC",
]

# cc_library(
#     name = "qt_moc_files",
#     srcs = ["@qt//:qt_moc"],
#     hdrs = ["MainWindow.h", "PipelineEditor.h", "ElementLibrary.h", "GstPipelineModel.h"],
#     includes = ["$(GENDIR)"],
#     visibility = ["//visibility:public"],
# )

cc_binary(
    name = "gst_pipeline_studio",
    srcs = ["main.cpp"],
    copts = COMMON_COPTS,
    deps = [
        ":main_window",
        #":element_library",
        #":gst_pipeline_model",
        "@qt//:qt_widgets",
        "@gstreamer",
    ],
)

# Run Qt's MOC on GstElementWidget
genrule(
    name = "gst_element_widget_moc",
    srcs = ["GstElementWidget.h"],
    outs = ["moc_GstElementWidget.cpp"],
    cmd = "$(location @qt//:qt_moc) $(location GstElementWidget.h) -o $@",
    tools = ["@qt//:qt_moc"],
)

genrule(
    name = "main_window_moc",
    srcs = ["MainWindow.h"],
    outs = ["moc_MainWindow.cpp"],
    cmd = "$(location @qt//:qt_moc) $(location MainWindow.h) -o $@",
    tools = ["@qt//:qt_moc"],
)

genrule(
    name = "pipeline_editor_moc",
    srcs = ["PipelineEditor.h"],
    outs = ["moc_PipelineEditor.cpp"],
    cmd = "$(location @qt//:qt_moc) $(location PipelineEditor.h) -o $@",
    tools = ["@qt//:qt_moc"],
)

genrule(
    name = "element_library_moc",
    srcs = ["ElementLibrary.h"],
    outs = ["moc_ElementLibrary.cpp"],
    cmd = "$(location @qt//:qt_moc) $(location ElementLibrary.h) -o $@",
    tools = ["@qt//:qt_moc"],
)

genrule(
    name = "gst_pipeline_model_moc",
    srcs = ["GstPipelineModel.h"],
    outs = ["moc_GstPipelineModel.cpp"],
    cmd = "$(location @qt//:qt_moc) $(location GstPipelineModel.h) -o $@",
    tools = ["@qt//:qt_moc"],
)

cc_library(
    name = "main_window",
    srcs = [
        "MainWindow.cpp",
        ":main_window_moc",
    ],
    hdrs = ["MainWindow.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":element_library",
        ":gst_pipeline_model",
        ":pipeline_editor",
        "@gstreamer",
        "@qt//:qt_widgets",
    ],
)

cc_library(
    name = "pipeline_editor",
    srcs = [
        "PipelineEditor.cpp",
        ":pipeline_editor_moc",
    ],
    hdrs = ["PipelineEditor.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":gst_element_widget",
        ":gst_pipeline_model",
        "@qt//:qt_widgets",
    ],
)

cc_library(
    name = "gst_element_widget",
    srcs = [
        "GstElementWidget.cpp",
        ":gst_element_widget_moc",  # Include the generated MOC file
    ],
    hdrs = ["GstElementWidget.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "@qt//:qt_widgets",
    ],
)

cc_library(
    name = "gst_pipeline_model",
    srcs = [
        "GstPipelineModel.cpp",
        ":gst_pipeline_model_moc",
    ],
    hdrs = ["GstPipelineModel.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":connection",
        ":element",
        "@gstreamer",
        "@qt//:qt_core",
    ],
)

cc_library(
    name = "element_library",
    srcs = [
        "ElementLibrary.cpp",
        ":element_library_moc",
    ],
    hdrs = ["ElementLibrary.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "@gstreamer",
        "@qt//:qt_widgets",
    ],
)

cc_library(
    name = "pipeline",
    srcs = ["Pipeline.cpp"],
    hdrs = ["Pipeline.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":connection",
        ":element",
        "@qt//:qt_core",
    ],
)

cc_library(
    name = "element",
    srcs = ["Element.cpp"],
    hdrs = ["Element.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "@qt//:qt_core",
    ],
)

cc_library(
    name = "connection",
    srcs = ["Connection.cpp"],
    hdrs = ["Connection.h"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "@qt//:qt_core",
    ],
)
