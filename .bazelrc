
#build --compiler=clang
build --nokeep_going --color=yes
# build --crosstool_top=@toolchain//crosstool:toolchain
build --copt=-fPIC
build --copt=-std=c++17
build --copt=-DABSL_NO_XPACLRI
build --copt=-fmax-errors=4
build --linkopt=-Wl,-rpath,/opt/nvidia/deepstream/deepstream/lib
build --linkopt=-Wl,-rpath,/opt/nvidia/deepstream/deepstream/lib/gst-plugins

# build --copt=-fdiagnostics-path-format=absolute
# Add full path to all C++ compilations
# build --copt=-H  # or --copt=-full-path depending on your compiler
# build --copt=-H
# build --copt=-full-path
# build --copt=-mcpu=native
# build --copt=-mtune=native

# Only for C++ files
# build --per_file_copt=.*\\.cpp$@-H
# build --per_file_copt=.*\\.cc$@-H
# build --per_file_copt=.*\\.hpp$@-H

# build --aspects @com_grail_bazel_compdb//:aspects.bzl%compilation_database_aspect
# build --output_groups=compilation_database_files

#build -c opt
build:opt -c opt
build:opt --copt=-O3

build:debug -c dbg --strip="never"
build:debug --copt=-g3
build:debug --copt=-O0
build:debug --copt=-UNDEBUG
# build:debug --copt=-v
build:debug --copt=-fdiagnostics-color=always
# build:debug --linkopt=-v
build:debug --linkopt=-Wl,-g
build:debug --linkopt=-Wl,--discard-none

build:gstdebug --config=debug
build:gstdebug --define=gstreamer_build=gst_debug

# build:debug --sandbox_debug

# build:opt -c opt --strip="always"

build:asan --platforms=//bazel/toolchain:asan
build:asan --strip=never
build:asan --platform_suffix=asan
build:asan --features=asan


# build --define=target_platform=x86_64
# build --action_env=target_platform="x86_64"
build:x86_64 --cpu=k8
build:x86_64 --define=target_platform=x86_64
build:x86_64 --action_env=target_platform="x86_64"

# Opt-in host config for RTX 50xx / Blackwell systems. Do not include this in
# default opt/debug configs; older CUDA toolchains cannot compile sm_120.
build:blackwell --@rules_cuda//cuda:archs=sm_75;sm_120

# Debian artifacts use explicit CUDA toolchains and native SASS targets. This
# avoids relying on PTX JIT compatibility with whatever driver a target host
# happens to have installed.
build:deb_ubuntu24 --repo_env=CUDA_PATH=/usr/local/cuda-12.6
build:deb_ubuntu24 --@rules_cuda//cuda:archs=sm_70;sm_89
build:deb_ubuntu26 --repo_env=CUDA_PATH=/usr/local/cuda-13.2
build:deb_ubuntu26 --@rules_cuda//cuda:archs=sm_89;sm_120

build:arm64 --define=target_platform=arm64
build:arm64 --action_env=target_platform="arm64"
build:arm64 --copt=-DABSL_NO_XPACLRI
build:arm64 --copt=-DAARCH64_IS_SBSA=1

# Backward-compatible alias.
build:aarch64 --config=arm64


build:jetson --define=target_platform=jetson
build:jetson --action_env=target_platform="jetson"
build:jetson --platforms=//platforms:jetson
build:jetson --extra_toolchains=//toolchains/jetson:jetson_toolchain
build:jetson --incompatible_enable_cc_toolchain_resolution
build:jetson --copt=-DIS_TEGRA=1
build:jetson --copt=-DABSL_NO_XPACLRI
build:jetson --copt=-mbranch-protection=none
build:jetson --linkopt=-l:libstdc++.so.6
build:jetson --linkopt=-l:libsystemd.so.0
build:jetson --linkopt=-lm
build:jetson --repo_env=OPENCV_ROOT=/opt/jetson-sysroot/usr
build:jetson --repo_env=CUDA_PATH=/opt/jetson-sysroot/usr/local/cuda
