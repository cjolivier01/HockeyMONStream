@@ -29,6 +29,49 @@
 #include "logging.h"
 
 #include <sstream>
+
+namespace {
+void set_http_status(WebRTCSoupMessage* message, guint status) {
+#if SOUP_MAJOR_VERSION >= 3
+  soup_server_message_set_status(message, status, nullptr);
+#else
+  soup_message_set_status(message, status);
+#endif
+}
+void set_http_response(WebRTCSoupMessage* message, const char* type, const char* data, gsize length) {
+#if SOUP_MAJOR_VERSION >= 3
+  soup_server_message_set_response(message, type, SOUP_MEMORY_COPY, data, length);
+#else
+  soup_message_set_response(message, type, SOUP_MEMORY_COPY, data, length);
+#endif
+}
+const char* peer_host(WebRTCClientContext* context) {
+#if SOUP_MAJOR_VERSION >= 3
+  return soup_server_message_get_remote_host(context);
+#else
+  return soup_client_context_get_host(context);
+#endif
+}
+const char* http_method(WebRTCSoupMessage* message) {
+#if SOUP_MAJOR_VERSION >= 3
+  return soup_server_message_get_method(message);
+#else
+  return message->method;
+#endif
+}
+bool set_tls_certificate(SoupServer* server, const char* certificate, const char* key, GError** error) {
+#if SOUP_MAJOR_VERSION >= 3
+  GTlsCertificate* tls = g_tls_certificate_new_from_files(certificate, key, error);
+  if (!tls) return false;
+  soup_server_set_tls_certificate(server, tls);
+  g_object_unref(tls);
+  return true;
+#else
+  return soup_server_set_ssl_cert_file(server, certificate, key, error);
+#endif
+}
+}  // namespace
+
 
 
